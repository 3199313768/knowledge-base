SUPABASE_ENVIRONMENT=development
# Add this ref to apps/cloud-foundation/src/approvedTestProjects.ts through code review first.
SUPABASE_TEST_PROJECT_REF=replace-with-approved-dedicated-development-project-ref
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# Trusted server and processing worker only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
RESEND_API_KEY=replace-only-when-email-delivery-is-approved
INVITATION_FROM_EMAIL=KnowledgeBase <invite@example.com>

# Processing worker only. Values are intentionally blank.
PROCESSING_WORKER_ID=
PROCESSING_MODEL_CACHE=
PROCESSING_LEASE_SECONDS=
PROCESSING_HEARTBEAT_SECONDS=
PROCESSING_IDLE_POLL_SECONDS=
PROCESSING_ARTIFACT_SWEEP_SECONDS=
PROCESSING_TERMINAL_ARTIFACT_GRACE_SECONDS=
PROCESSING_JOB_TIMEOUT_SECONDS=
